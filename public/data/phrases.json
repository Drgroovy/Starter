ase","category":"Spicy Food","english":"Not spicy, please.","japanese":"辛くしないでください。","romaji":"karaku shinaide kudasai","easyPronunciation":"kah-rah-koo shee-nye-deh koo-dah-sai","note":"Use before ordering.","politeness":"polite","tags":["not","spicy"]},{"id":"spicy-food-extra-spicy-please","category":"Spicy Food","english":"Extra spicy, please.","japanese":"もっと辛くしてください。","romaji":"motto karaku shite kudasai","easyPronunciation":"moht-toh kah-rah-koo shee-teh koo-dah-sai","note":"For the bold.","politeness":"polite","tags":["extra","spicy"]},{"id":"spicy-food-my-mouth-is-on-fire","category":"Spicy Food","english":"My mouth is on fire.","japanese":"口が燃えています。","romaji":"kuchi ga moete imasu","easyPronunciation":"koo-chee gah moh-eh-teh ee-mahss","note":"Dramatic but understandable.","politeness":"polite","tags":["mouth","fire"]}]